{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoshinos-agenda-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-13",
  "assets": {
    "directory": "../web/.output/public",
    "not_found_handling": "single-page-application",
    // API（包括浏览器直接导航）必须交给 Worker，不能回退到 SPA HTML。
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    // 同源请求自动允许；仅额外跨域客户端需要配置。逗号分隔，支持 * 通配符。
    "ALLOWED_ORIGINS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agenda-db",
      "database_id": "b00e9432-2cd1-4455-b485-c783d3082dbd",
      "migrations_dir": "migrations"
    }
  ]
}
