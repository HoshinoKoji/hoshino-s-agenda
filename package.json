{
  "name": "hoshinos-agenda",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "db:migrate": "bun run --filter @agenda/api db:migrate",
    "db:migrate:remote": "bun run --filter @agenda/api db:migrate:remote",
    "typecheck": "bun run --filter '*' typecheck && bun run typecheck:tests",
    "typecheck:tests": "tsc --project tsconfig.tests.json",
    "build": "bun run --filter @agenda/web generate && bun run --filter @agenda/api build",
    "preview": "bun run --filter @agenda/api preview",
    "doctor": "node scripts/doctor.mjs",
    "test": "node scripts/test.mjs",
    "test:toolchain": "node --test scripts/test.test.mjs",
    "test:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "test:deps": "playwright install-deps chromium",
    "android:setup": "node scripts/android.mjs setup",
    "android:build": "node scripts/android.mjs build",
    "android:test": "node scripts/android.mjs test",
    "android:check": "node scripts/android.mjs check",
    "android:assetlinks": "node scripts/android.mjs assetlinks",
    "deploy": "bun run --filter @agenda/web generate && bun run --filter @agenda/api deploy",
    "deploy:api": "bun run deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.5.1",
    "bun": "1.3.14",
    "typescript": "^5.9.2"
  },
  "optionalDependencies": {
    "node-linux-arm64": "22.23.3",
    "node-linux-x64": "22.23.3"
  },
  "trustedDependencies": ["bun"]
}
