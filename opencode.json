{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "question": "allow",
    "read": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "list": {
      "*": "allow"
    },
    "glob": {
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git branch --show-current": "allow",
      "git remote -v": "allow",
      "bun --version": "allow",
      "bun run bun --version": "allow",
      "bun run node --version": "allow",
      "bun run typecheck": "allow",
      "bun run typecheck:tests": "allow",
      "bun run build": "allow",
      "bun run doctor": "allow",
      "bun run test": "allow",
      "bun run test *": "allow",
      "bun run test:toolchain": "allow",
      "bun run dev": "allow",
      "bun run preview": "allow",
      "bun run --filter @agenda/web typecheck": "allow",
      "bun run --filter @agenda/api typecheck": "allow",
      "bun run --filter @agenda/web generate": "allow",
      "bun run --filter @agenda/api build": "allow",
      "bun run --filter @agenda/web dev": "allow",
      "bun run --filter @agenda/api dev": "allow",
      "bun run playwright show-report": "allow",
      "bun run playwright show-report *": "allow",
      "bun run playwright show-trace *": "allow",
      "AGENDA_TEST_PORT=18787 bun run test": "allow",
      "AGENDA_TEST_PORT=18787 bun run test *": "allow",
      "AGENDA_TEST_DEV=1 AGENDA_TEST_PORT=18787 bun run test": "allow",
      "AGENDA_TEST_DEV=1 AGENDA_TEST_PORT=18787 bun run test *": "allow",
      "LD_LIBRARY_PATH=\"$PWD/.wrangler/browser-runtime/root/usr/lib/x86_64-linux-gnu:$PWD/.wrangler/browser-runtime/root/lib/x86_64-linux-gnu\" FONTCONFIG_FILE=\"$PWD/.wrangler/browser-runtime/fonts.conf\" AGENDA_TEST_PORT=18787 bun run test": "allow",
      "LD_LIBRARY_PATH=\"$PWD/.wrangler/browser-runtime/root/usr/lib/x86_64-linux-gnu:$PWD/.wrangler/browser-runtime/root/lib/x86_64-linux-gnu\" FONTCONFIG_FILE=\"$PWD/.wrangler/browser-runtime/fonts.conf\" AGENDA_TEST_PORT=18787 bun run test *": "allow",
      "LD_LIBRARY_PATH=\"$PWD/.wrangler/browser-runtime/root/usr/lib/x86_64-linux-gnu:$PWD/.wrangler/browser-runtime/root/lib/x86_64-linux-gnu\" FONTCONFIG_FILE=\"$PWD/.wrangler/browser-runtime/fonts.conf\" bun run doctor": "allow",
      "*&&*": "ask",
      "*||*": "ask",
      "* | *": "ask",
      "*;*": "ask",
      "*$(*": "ask",
      "*`*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*--config*": "ask",
      "*--import*": "ask",
      "*--require*": "ask",
      "*--loader*": "ask",
      "*--reporter*": "ask",
      "*--ext-diff*": "ask",
      "*--textconv*": "ask",
      "*--output*": "ask",
      "*--remote*": "ask"
    }
  }
}
